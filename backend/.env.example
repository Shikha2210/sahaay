# Copy to backend/.env (never commit .env). Fill in your own values.
# MongoDB Atlas -> Connect -> Drivers -> copy the SRV string. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=sahaay
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Added later (AI milestone). Leave empty until then; the chatbot returns 503 without it.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional tuning (defaults shown). The key stays on the backend; the browser never sees it.
# AI_TIMEOUT_SECONDS=20
# AI_RATE_PER_MINUTE=10
# AI_GLOBAL_PER_MINUTE=30
# First-start supervisor account. Choose your own password.
# No built-in password exists. Required only until the first supervisor has been created: >=12 chars,
# upper+lower+digit+symbol, no common words. Use a real email domain (.local/.test/.invalid are rejected).
BOOTSTRAP_SUPERVISOR_EMAIL=supervisor@example.com
BOOTSTRAP_SUPERVISOR_PASSWORD=
# Synthetic demo patients. Keep false unless you want them.
SEED_DEMO_DATA=false

# --- Production (see documentation/DEPLOYMENT_GUIDE.md) ---
# ENVIRONMENT=production turns on strict startup checks, hides /docs and adds HSTS. In production CORS_ORIGINS must be https:// only,
# SEED_DEMO_DATA must be false and the Atlas URI must use TLS (mongodb+srv://).
# ENVIRONMENT=development
# Set true ONLY behind a reverse proxy you control that sets X-Forwarded-For (used for rate limits and audit IPs).
# TRUST_PROXY_HEADERS=false
