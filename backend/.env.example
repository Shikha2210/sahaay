# Copy to backend/.env (never commit .env). Fill in your own values.
# MongoDB Atlas -> Connect -> Drivers -> copy the SRV string. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=sahaay
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Added later (AI milestone). Leave empty until then; the chatbot returns 503 without it.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# First-start supervisor account. Choose your own password.
# NOTE: the current code still falls back to a known default if this is empty (audit X1, fixed in Milestone 2).
BOOTSTRAP_SUPERVISOR_EMAIL=supervisor@sahaay.local
BOOTSTRAP_SUPERVISOR_PASSWORD=
# Synthetic demo patients. Keep false unless you want them.
SEED_DEMO_DATA=false
